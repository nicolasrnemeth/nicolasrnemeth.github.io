---
import BaseLayout from '@/layouts/BaseLayout.astro';
import OrbitMark from '@/components/OrbitMark.astro';
import { useTranslations } from '@/i18n/ui';

const t = useTranslations('en');
---

<BaseLayout
  title={t('404.title')}
  description={t('404.lead')}
  locale="en"
  route={{ kind: 'none' }}
  path="/404"
  noindex
>
  <div class="container notfound">
    <OrbitMark size="2.5rem" />
    <p class="notfound__code mono">404</p>
    <h1 class="notfound__title">{t('404.title')}</h1>
    <p class="notfound__lead">{t('404.lead')}</p>
    <a class="btn btn--primary" href="/">{t('404.cta')}</a>
  </div>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-s);
    padding-block: var(--space-3xl);
  }

  .notfound__code {
    margin-block-start: var(--space-m);
    font-size: var(--step--1);
    letter-spacing: 0.35em;
    color: var(--accent);
  }

  .notfound__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }

  .notfound__lead {
    max-inline-size: 30rem;
    color: var(--text-2);
  }

  .notfound .btn {
    margin-block-start: var(--space-m);
  }
</style>
