---
import type { Locale } from '@/config/site';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button class="theme-toggle" type="button" aria-label={t('theme.toggle')} title={t('theme.toggle')}>
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path
      d="M12 2.6v2.3M12 19.1v2.3M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.6 12h2.3M19.1 12h2.3M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"
    ></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.4A8.4 8.4 0 1 1 9.6 4a6.9 6.9 0 0 0 10.4 10.4Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    inline-size: 2.35rem;
    block-size: 2.35rem;
    padding: 0;
    color: var(--text-2);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .theme-toggle__icon {
    grid-area: 1 / 1;
    inline-size: 1.1rem;
    block-size: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--sun,
  :global(:root[data-theme='light']) .theme-toggle__icon--moon {
    opacity: 0;
    transform: scale(0.6) rotate(-45deg);
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--moon,
  :global(:root[data-theme='light']) .theme-toggle__icon--sun {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  const STORAGE_KEY = 'theme';

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        /* storage unavailable, so the choice simply will not persist */
      }
    });
  });
</script>
